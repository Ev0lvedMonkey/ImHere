<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/prototype_title"
            android:textColor="#FF212121"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/prototype_subtitle"
            android:textColor="#FF424242"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#FFF5F5F5"
            android:padding="12dp"
            android:textColor="#FF212121"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_grant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/prototype_grant_permissions" />

        <Button
            android:id="@+id/btn_open_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="@string/prototype_open_settings" />

        <TextView
            android:id="@+id/tv_denied_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/prototype_permission_denied_hint"
            android:textColor="#FFB3261E"
            android:textSize="14sp"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/cb_debug_inexact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/prototype_debug_inexact" />

        <CheckBox
            android:id="@+id/cb_debug_delay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/prototype_debug_delay" />

        <Button
            android:id="@+id/btn_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/prototype_run_test" />

        <Button
            android:id="@+id/btn_check_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/prototype_check_location" />

        <TextView
            android:id="@+id/tv_location_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFF5F5F5"
            android:padding="12dp"
            android:textColor="#FF212121"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/prototype_sms_section"
            android:textColor="#FF212121"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_sms_recipient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints="phone"
            android:hint="@string/prototype_sms_recipient_hint"
            android:importantForAutofill="yes"
            android:inputType="phone"
            android:maxLines="1" />

        <CheckBox
            android:id="@+id/cb_sms_dry_run"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/prototype_sms_dry_run" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/prototype_sms_dry_run_hint"
            android:textColor="#FF424242"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_send_test_sms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/prototype_send_test_sms" />

        <TextView
            android:id="@+id/tv_sms_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFF5F5F5"
            android:padding="12dp"
            android:textColor="#FF212121"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/prototype_instructions"
            android:textColor="#FF424242"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
