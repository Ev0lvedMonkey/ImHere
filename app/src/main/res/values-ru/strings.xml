    <string name="app_name">ImHere</string>

    <!-- Prototype screen -->
    <string name="prototype_title">ImHere — прототип виджета</string>
    <string name="prototype_subtitle">Проверочная сборка SOS-виджета. Двойное нажатие запускает фоновое получение геолокации. SMS в прототипе не отправляются.</string>
    <string name="prototype_instructions">1. Выдайте разрешения.\n2. Добавьте виджет ImHere на рабочий стол (долгое нажатие на рабочем столе → Виджеты).\n3. Нажмите на виджет один раз, затем второй раз в течение 2 секунд.\n4. Смотрите уведомление и лог с тегом ImHerePrototype.</string>
    <string name="prototype_permissions_status">Разрешение на геолокацию: %1$s\nРазрешение на уведомления: %2$s\nСлужбы геолокации: %3$s\nСервисы Google Play: %4$s</string>
